{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engram.local/extension-contracts/prisoma.observer.finish-response.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "outcome",
    "reason",
    "authority",
    "roster_authority",
    "source_roster_authenticated",
    "study_run_id",
    "step_index",
    "channel_count",
    "fault_count",
    "cumulative_fault_count",
    "source_receipt_sha256",
    "prior_observer_state_sha256",
    "observer_state_sha256",
    "request_sha256",
    "observer_receipt_sha256",
    "observer_transcript_sha256",
    "terminal",
    "state_cleared",
    "descriptive_only",
    "agent_bridge_command",
    "physical_actuation",
    "ncp_used",
    "pid_result",
    "source_durable_evidence_verified",
    "scientific_authority",
    "is_paper_local_evidence",
    "calibrated_posterior"
  ],
  "properties": {
    "schema_version": { "const": "prisoma.observer.finish-response.v1" },
    "outcome": { "enum": ["succeeded", "rejected", "failed"] },
    "reason": { "type": "string", "minLength": 1, "maxLength": 256 },
    "authority": { "const": "read-only-observer" },
    "roster_authority": { "const": "host-declared-projection" },
    "source_roster_authenticated": { "const": false },
    "study_run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "step_index": { "type": "integer", "minimum": 0, "maximum": 1024 },
    "channel_count": { "type": "integer", "minimum": 0, "maximum": 64 },
    "fault_count": { "type": "integer", "minimum": 0, "maximum": 64 },
    "cumulative_fault_count": { "type": "integer", "minimum": 0, "maximum": 65536 },
    "source_receipt_sha256": { "$ref": "#/$defs/nullable_sha256" },
    "prior_observer_state_sha256": { "$ref": "#/$defs/sha256" },
    "observer_state_sha256": { "$ref": "#/$defs/sha256" },
    "request_sha256": { "$ref": "#/$defs/sha256" },
    "observer_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "observer_transcript_sha256": { "$ref": "#/$defs/sha256" },
    "terminal": { "type": "boolean" },
    "state_cleared": { "type": "boolean" },
    "descriptive_only": { "const": true },
    "agent_bridge_command": { "const": false },
    "physical_actuation": { "const": false },
    "ncp_used": { "const": false },
    "pid_result": { "const": false },
    "source_durable_evidence_verified": { "const": false },
    "scientific_authority": { "const": false },
    "is_paper_local_evidence": { "const": false },
    "calibrated_posterior": { "const": false }
  },
  "$defs": {
    "sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
    "nullable_sha256": {
      "anyOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    }
  }
}
