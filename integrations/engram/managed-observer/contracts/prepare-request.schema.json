{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engram.local/extension-contracts/prisoma.observer.prepare-request.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_run_id",
    "study_definition_sha256",
    "closed_loop_definition_sha256",
    "runtime_binding_sha256",
    "runtime_adapter_configuration_sha256",
    "neural_provider_identity_sha256",
    "channel_ids",
    "subject_ids",
    "planned_step_count",
    "max_steps"
  ],
  "properties": {
    "schema_version": { "const": "prisoma.observer.prepare-request.v1" },
    "study_run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "study_definition_sha256": { "$ref": "#/$defs/sha256" },
    "closed_loop_definition_sha256": { "$ref": "#/$defs/sha256" },
    "runtime_binding_sha256": { "$ref": "#/$defs/sha256" },
    "runtime_adapter_configuration_sha256": { "$ref": "#/$defs/sha256" },
    "neural_provider_identity_sha256": { "$ref": "#/$defs/sha256" },
    "channel_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/entity_id" }
    },
    "subject_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/entity_id" }
    },
    "planned_step_count": { "type": "integer", "minimum": 1, "maximum": 1024 },
    "max_steps": { "type": "integer", "minimum": 1, "maximum": 1024 }
  },
  "$defs": {
    "sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
    "entity_id": { "type": "string", "minLength": 1, "maxLength": 128 }
  }
}
