{
  "schema_version": "1.0",
  "manifest_template": "manifest.template.json",
  "package_root": "package",
  "configuration_path": "configuration.json",
  "target": {
    "target_id": "macos-aarch64-darwin",
    "operating_system": "macos",
    "architecture": "aarch64",
    "abi": "darwin"
  },
  "executable": {
    "package_relative_path": "bin/prisoma-engram-managed-observer",
    "launch_abi": "engram.managed-runtime-stdio.v1"
  },
  "schemas": [
    {
      "schema_id": "engram.managed-runtime-ipc.v1",
      "package_relative_path": "contracts/managed-runtime-ipc.schema.json"
    },
    {
      "schema_id": "prisoma.observer.configuration.v1",
      "package_relative_path": "contracts/configuration.schema.json"
    },
    {
      "schema_id": "prisoma.observer.finish-request.v1",
      "package_relative_path": "contracts/finish-request.schema.json"
    },
    {
      "schema_id": "prisoma.observer.finish-response.v1",
      "package_relative_path": "contracts/finish-response.schema.json"
    },
    {
      "schema_id": "prisoma.observer.observe-request.v1",
      "package_relative_path": "contracts/observe-request.schema.json"
    },
    {
      "schema_id": "prisoma.observer.observe-response.v1",
      "package_relative_path": "contracts/observe-response.schema.json"
    },
    {
      "schema_id": "prisoma.observer.prepare-request.v1",
      "package_relative_path": "contracts/prepare-request.schema.json"
    },
    {
      "schema_id": "prisoma.observer.prepare-response.v1",
      "package_relative_path": "contracts/prepare-response.schema.json"
    }
  ],
  "output_directory": "sealed/macos-aarch64-darwin"
}
